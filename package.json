{
  "name": "math-cosmos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "ci": "npm run typecheck && npm test && npm run build && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify:ego": "ego-browser nodejs < scripts/ego-smoke.js",
    "verify:resources": "ego-browser nodejs < scripts/ego-resource-audit.js",
    "verify:perf": "ego-browser nodejs < scripts/ego-perf-audit.js",
    "capture:visual": "ego-browser nodejs < scripts/ego-visual-baseline.js",
    "compare:visual": "python3 scripts/compare-visual-baseline.py"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "katex": "^0.19.1",
    "postprocessing": "^6.36.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.1"
  }
}
